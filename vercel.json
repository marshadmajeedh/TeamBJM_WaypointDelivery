{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:shared && npm run db:generate && npm run build --workspace=@waypoint/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": { "includeFiles": "packages/shared/dist/**" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
